# Multi-Agent Decision Court Configuration

# LLM Provider: 'openrouter', 'mock', 'openai', or 'huggingface'
LLM_PROVIDER=openrouter

# OpenRouter API Configuration
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=minimax/minimax-m3:free
FALLBACK_LLM_MODEL=google/gemma-4-31b-it:free

# Database Configuration (Defaults to local SQLite)
DATABASE_URL=sqlite+aiosqlite:///./court.db

# App Security & Execution Limits
SECRET_KEY=change-this-secret-key-in-production-32-chars-minimum
MAX_DEBATE_ROUNDS=3
LLM_TIMEOUT_SECONDS=60.0
TEMPERATURE=0.2
