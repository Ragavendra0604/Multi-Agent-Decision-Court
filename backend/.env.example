# Multi-Agent Decision Court Configuration

# LLM Provider: 'groq', 'openrouter', 'mock', or 'openai'
LLM_PROVIDER=groq

# Groq API Configuration (Recommended: Free, ~300 tokens/sec, high limits)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
FALLBACK_LLM_MODEL=llama-3.1-8b-instant

# OpenRouter API Configuration (Alternative)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# Database Configuration (Defaults to local SQLite)
DATABASE_URL=sqlite+aiosqlite:///./court.db

# App Security & Execution Limits
SECRET_KEY=change-this-secret-key-in-production-32-chars-minimum
MAX_DEBATE_ROUNDS=3
LLM_TIMEOUT_SECONDS=60.0
TEMPERATURE=0.2
